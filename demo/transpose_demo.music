# play 移调参数测试：(+N)/(-N) 半音、嵌套累加、错误处理
speed bpm 140
echo off

主题 {
1 2 3 4 |
5 6 7 1^ |
}

变奏 {
# 嵌套：变奏(+3) 时这里实际 +5
play 主题(+2)
}

# 原调 C：60 62 64 65 ...
play 主题
wait 300ms
# 升全音 D：62 64 66 67 ...
play 主题(+2)
wait 300ms
# 降小三度：57 59 61 62（半音移调是色彩音，非自然音阶）
play 主题(-3)
wait 300ms
# 嵌套累加 +5：65 67 69 70 ...
play 变奏(+3)
wait 300ms
# 高八度：72 74 76 77 ...
play 主题(+12)
