# instrument 指令测试：中文名 / 英文名 / program 号 / 未知名回退
speed bpm 120

旋律 {
instrument 小提琴
1 2 3 5 |
}

伴奏 {
instrument flute
[1,3,5,] [1,3,5,] [1,4,6,] [1,3,5,] |
}

贝斯 {
instrument 33
1,,-- 5,,,-- 4,,-- 1,,-- |
}

ensemble {
play 旋律
play 伴奏
play 贝斯
}

# 段内音色不外泄：这里应回到标准钢琴
1 2 3 4 |

# 中途换音色（主流同一声部内）
instrument 八音盒
5 6 7 1^ |

# 未知名 → warning + 回退钢琴
instrument 蓬莱山辉夜的古琴
1 2 3 |
